 "rules": [
  {
   "when": [
    {
     "field": "which_documents_are_you_ready_to_upload",
     "operator": "any",
     "value": [
      "Copy of Drivers License (required)",
      "Copy of Contract / Work Order (blank acceptable)",
      "Voided Business Check (required)",
      "Voided Business Check",
      "Contractor's/Installer's License (required depending on state)",
      "Business License/Registration (required depending on state)",
      "Business Liability Insurance/Bonding (required for home improvement contractors)"
     ]
    }
   ],
   "shows": [
    "file_upload"
   ]
  },
  {
   "when": [
    {
     "field": "short_answer_d15c",
     "operator": "notEmpty",
     "value": true
    }
   ],
   "shows": [
    "amount_of_sales_financed_in_months"
   ]
  },
  {
   "when": [
    {
     "field": "do_you_subcontract",
     "operator": "any",
     "value": [
      "Yes"
     ]
    }
   ],
   "shows": [
    "list_what_percentage_your_business_subcontracts"
   ]
  },
  {
   "when": [
    {
     "field": "how_many_owners_are_there",
     "operator": "equal",
     "value": "1"
    }
